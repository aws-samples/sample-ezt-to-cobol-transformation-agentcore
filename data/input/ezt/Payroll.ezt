
PARM DEBUG(FLOW FLDCHK)
*------------------------------------------------------------
* COMPREHENSIVE EMPLOYEE PAYROLL PROCESSING SYSTEM
* - READS EMPLOYEE MASTER AND TRANSACTION FILES
* - PERFORMS FILE MATCHING AND VALIDATION
* - CALCULATES SALARY, TAX, DEDUCTIONS, NET PAY
* - GENERATES DETAIL, SUMMARY, AND ERROR REPORTS
*------------------------------------------------------------
*
*--- INPUT FILE: EMPLOYEE MASTER ---
FILE EMPMASTR FB(200 2000)
  EMP-ID                  1   6 N  HEADING ('EMP' 'ID')
  EMP-NAME                7  20 A  HEADING ('EMPLOYEE' 'NAME')
    EMP-LAST-NAME    EMP-NAME     10 A
    EMP-FIRST-NAME   EMP-NAME +10 10 A
  EMP-DEPT               27   4 A  HEADING ('DEPT' 'CODE')
  EMP-GRADE              31   2 N  HEADING ('PAY' 'GRADE')
  EMP-STATUS             33   1 A  HEADING ('STAT')
  EMP-BASE-PAY           34   5 P 2 HEADING ('BASE' 'PAY')
  EMP-HIRE-DATE          39   8 N  HEADING ('HIRE' 'DATE')
    HIRE-YYYY    EMP-HIRE-DATE     4 N
    HIRE-MM      EMP-HIRE-DATE +4  2 N
    HIRE-DD      EMP-HIRE-DATE +6  2 N
  EMP-REGION             47   3 A  HEADING ('REG')
  EMP-UNION-CODE         50   2 A  HEADING ('UNION' 'CODE')
  EMP-BENEFIT-PLAN       52   1 A  HEADING ('BEN' 'PLAN')
  EMP-TAX-EXEMPT         53   2 N  HEADING ('TAX' 'EXMPT')
  EMP-401K-PCT           55   3 P 2 HEADING ('401K' 'PCT')
  EMP-PERF-RATING        58   1 N  HEADING ('PERF' 'RATE')
*
*--- INPUT FILE: PAYROLL TRANSACTIONS ---
FILE PAYTRANS FB(100 1000)
  TRN-EMP-ID              1   6 N  HEADING ('EMP' 'ID')
  TRN-PAY-PERIOD          7   6 N  HEADING ('PAY' 'PERIOD')
  TRN-REG-HOURS          13   3 P 2 HEADING ('REG' 'HRS')
  TRN-OVT-HOURS          16   3 P 2 HEADING ('OVT' 'HRS')
  TRN-SICK-HOURS          19  3 P 2 HEADING ('SICK' 'HRS')
  TRN-VAC-HOURS           22  3 P 2 HEADING ('VAC' 'HRS')
  TRN-MISC-EARN           25  4 P 2 HEADING ('MISC' 'EARN')
  TRN-MISC-DEDUCT         29  4 P 2 HEADING ('MISC' 'DED')
  TRN-TYPE                33  1 A  HEADING ('TRN' 'TYPE')
*
*--- OUTPUT FILES ---
FILE RPTFILE PRINTER
FILE ERRFILE PRINTER
FILE OUTFILE FB(150 1500)
  OUT-REC                  1 150 A
*
*--- WORKING STORAGE VARIABLES ---
  WS-GROSS-PAY       W  5 P 2
  WS-OVT-PAY         W  5 P 2
  WS-REG-PAY         W  5 P 2
  WS-FED-TAX         W  5 P 2
  WS-STATE-TAX       W  5 P 2
  WS-FICA-TAX        W  5 P 2
  WS-MEDICARE        W  5 P 2
  WS-TOTAL-TAX       W  5 P 2
  WS-401K-AMT        W  5 P 2
  WS-BENEFIT-DED     W  5 P 2
  WS-UNION-DUES      W  4 P 2
  WS-TOTAL-DEDUCT    W  5 P 2
  WS-NET-PAY         W  6 P 2
  WS-ANNUAL-SAL      W  6 P 2
  WS-RAISE-PCT       W  3 P 2
  WS-RAISE-AMT       W  5 P 2
  WS-NEW-SALARY      W  6 P 2
  WS-YRS-SERVICE     W  2 N
  WS-HOURLY-RATE     W  4 P 2
  WS-OVT-RATE        W  4 P 2
  WS-TOTAL-HOURS     W  3 P 2
  WS-ERR-COUNT       W  4 N  VALUE 0
  WS-REC-COUNT       W  6 N  VALUE 0
  WS-PROC-COUNT      W  6 N  VALUE 0
  WS-MATCH-FLAG      W  1 A  VALUE ' '
*
*--- SYSTEM DATE FIELDS ---
  WS-CURR-DATE    S  8 N
    WS-CURR-YYYY  WS-CURR-DATE     4 N
    WS-CURR-MM    WS-CURR-DATE +4  2 N
    WS-CURR-DD    WS-CURR-DATE +6  2 N
*
*--- CONSTANTS ---
  WS-FED-TAX-RATE   W  3 P 4  VALUE 0.2200
  WS-STATE-TAX-RATE W  3 P 4  VALUE 0.0500
  WS-FICA-RATE      W  3 P 4  VALUE 0.0620
  WS-MEDICARE-RATE  W  3 P 4  VALUE 0.0145
  WS-OVT-MULT       W  2 P 2  VALUE 1.50
  WS-STD-HOURS      W  3 P 2  VALUE 40.00
  WS-FICA-LIMIT     W  6 P 2  VALUE 160200.00
*
*============================================================
* MAIN JOB - SYNCHRONIZED FILE MATCHING
*============================================================
JOB INPUT (EMPMASTR KEY EMP-ID +
           PAYTRANS KEY TRN-EMP-ID)
*
  %GETDATE WS-CURR-DATE
  WS-REC-COUNT = WS-REC-COUNT + 1
*
*--- CHECK MATCH STATUS ---
  IF EMPMASTR:MATCHED AND PAYTRANS:MATCHED
    WS-MATCH-FLAG = 'M'
    PERFORM VALIDATE-EMPLOYEE
    IF WS-MATCH-FLAG NE 'E'
      PERFORM CALC-GROSS-PAY
      PERFORM CALC-TAXES
      PERFORM CALC-DEDUCTIONS
      PERFORM CALC-NET-PAY
      PERFORM CALC-ANNUAL-REVIEW
      WS-PROC-COUNT = WS-PROC-COUNT + 1
      PRINT PAY-DETAIL-RPT
      PRINT PAY-SUMMARY-RPT
      IF WS-NET-PAY GT 5000
        PRINT HIGH-PAY-RPT
      END-IF
    END-IF
  ELSE
    IF EMPMASTR:MATCHED
      DISPLAY ERRFILE 'NO TRANSACTION FOR EMP: ' EMP-ID
      WS-ERR-COUNT = WS-ERR-COUNT + 1
    ELSE
      DISPLAY ERRFILE 'NO MASTER FOR TRN EMP: ' TRN-EMP-ID
      WS-ERR-COUNT = WS-ERR-COUNT + 1
    END-IF
  END-IF
*
*============================================================
* VALIDATE EMPLOYEE DATA
*============================================================
  VALIDATE-EMPLOYEE. PROC
    IF EMP-STATUS NE 'A'
      DISPLAY ERRFILE 'INACTIVE EMPLOYEE: ' EMP-ID +
                      ' STATUS: ' EMP-STATUS
      WS-MATCH-FLAG = 'E'
      WS-ERR-COUNT = WS-ERR-COUNT + 1
      GOTO QUIT-VALIDATE
    END-IF
    IF EMP-BASE-PAY LT 1
      DISPLAY ERRFILE 'INVALID BASE PAY FOR: ' EMP-ID
      WS-MATCH-FLAG = 'E'
      WS-ERR-COUNT = WS-ERR-COUNT + 1
      GOTO QUIT-VALIDATE
    END-IF
    IF EMP-GRADE LT 1 OR EMP-GRADE GT 15
      DISPLAY ERRFILE 'INVALID GRADE FOR: ' EMP-ID +
                      ' GRADE: ' EMP-GRADE
      WS-MATCH-FLAG = 'E'
      WS-ERR-COUNT = WS-ERR-COUNT + 1
      GOTO QUIT-VALIDATE
    END-IF
    IF TRN-REG-HOURS LT 0 OR TRN-REG-HOURS GT 80
      DISPLAY ERRFILE 'INVALID REG HOURS FOR: ' EMP-ID
      WS-MATCH-FLAG = 'E'
      WS-ERR-COUNT = WS-ERR-COUNT + 1
    END-IF
    IF TRN-OVT-HOURS LT 0 OR TRN-OVT-HOURS GT 40
      DISPLAY ERRFILE 'INVALID OVT HOURS FOR: ' EMP-ID
      WS-MATCH-FLAG = 'E'
      WS-ERR-COUNT = WS-ERR-COUNT + 1
    END-IF
    QUIT-VALIDATE
  END-PROC
*
*============================================================
* CALCULATE GROSS PAY
*============================================================
  CALC-GROSS-PAY. PROC
    WS-HOURLY-RATE = EMP-BASE-PAY / WS-STD-HOURS
    WS-OVT-RATE = WS-HOURLY-RATE * WS-OVT-MULT
    WS-REG-PAY = TRN-REG-HOURS * WS-HOURLY-RATE
    WS-OVT-PAY = TRN-OVT-HOURS * WS-OVT-RATE
    WS-GROSS-PAY = WS-REG-PAY + WS-OVT-PAY + TRN-MISC-EARN
    WS-TOTAL-HOURS = TRN-REG-HOURS + TRN-OVT-HOURS
  END-PROC
*
*============================================================
* CALCULATE TAXES (FEDERAL, STATE, FICA, MEDICARE)
*============================================================
  CALC-TAXES. PROC
*--- FEDERAL TAX WITH EXEMPTION ADJUSTMENT ---
    WS-FED-TAX = WS-GROSS-PAY * WS-FED-TAX-RATE
    IF EMP-TAX-EXEMPT GT 0
      WS-FED-TAX = WS-FED-TAX - (EMP-TAX-EXEMPT * 80.77)
    END-IF
    IF WS-FED-TAX LT 0
      WS-FED-TAX = 0
    END-IF
*--- STATE TAX ---
    WS-STATE-TAX = WS-GROSS-PAY * WS-STATE-TAX-RATE
*--- FICA TAX WITH ANNUAL LIMIT CHECK ---
    WS-ANNUAL-SAL = WS-GROSS-PAY * 26
    IF WS-ANNUAL-SAL GT WS-FICA-LIMIT
      WS-FICA-TAX = WS-FICA-LIMIT / 26 * WS-FICA-RATE
    ELSE
      WS-FICA-TAX = WS-GROSS-PAY * WS-FICA-RATE
    END-IF
*--- MEDICARE TAX ---
    WS-MEDICARE = WS-GROSS-PAY * WS-MEDICARE-RATE
*--- TOTAL TAX ---
    WS-TOTAL-TAX = WS-FED-TAX + WS-STATE-TAX + +
                   WS-FICA-TAX + WS-MEDICARE
  END-PROC
*
*============================================================
* CALCULATE DEDUCTIONS (401K, BENEFITS, UNION)
*============================================================
  CALC-DEDUCTIONS. PROC
*--- 401K CONTRIBUTION ---
    IF EMP-401K-PCT GT 0
      WS-401K-AMT = WS-GROSS-PAY * EMP-401K-PCT / 100
    ELSE
      WS-401K-AMT = 0
    END-IF
*--- BENEFIT PLAN DEDUCTIONS ---
    IF EMP-BENEFIT-PLAN EQ 'A'
      WS-BENEFIT-DED = 125.00
    ELSE
      IF EMP-BENEFIT-PLAN EQ 'B'
        WS-BENEFIT-DED = 250.00
      ELSE
        IF EMP-BENEFIT-PLAN EQ 'C'
          WS-BENEFIT-DED = 375.00
        ELSE
          WS-BENEFIT-DED = 0
        END-IF
      END-IF
    END-IF
*--- UNION DUES ---
    IF EMP-UNION-CODE NE '  '
      WS-UNION-DUES = 45.00
    ELSE
      WS-UNION-DUES = 0
    END-IF
*--- TOTAL DEDUCTIONS ---
    WS-TOTAL-DEDUCT = WS-TOTAL-TAX + WS-401K-AMT + +
                      WS-BENEFIT-DED + WS-UNION-DUES + +
                      TRN-MISC-DEDUCT
  END-PROC
*
*============================================================
* CALCULATE NET PAY
*============================================================
  CALC-NET-PAY. PROC
    WS-NET-PAY = WS-GROSS-PAY - WS-TOTAL-DEDUCT
    IF WS-NET-PAY LT 0
      DISPLAY ERRFILE 'NEGATIVE NET PAY FOR: ' EMP-ID +
                      ' AMT: ' WS-NET-PAY
      WS-ERR-COUNT = WS-ERR-COUNT + 1
    END-IF
  END-PROC
*
*============================================================
* CALCULATE ANNUAL REVIEW (RAISE BASED ON PERFORMANCE)
*============================================================
  CALC-ANNUAL-REVIEW. PROC
*--- CALCULATE YEARS OF SERVICE ---
    WS-YRS-SERVICE = WS-CURR-YYYY - HIRE-YYYY
    IF WS-CURR-MM LT HIRE-MM
      WS-YRS-SERVICE = WS-YRS-SERVICE - 1
    END-IF
    IF WS-CURR-MM EQ HIRE-MM
      IF WS-CURR-DD LT HIRE-DD
        WS-YRS-SERVICE = WS-YRS-SERVICE - 1
      END-IF
    END-IF
*--- DETERMINE RAISE PERCENTAGE BASED ON PERFORMANCE ---
    IF EMP-PERF-RATING EQ 5
      WS-RAISE-PCT = 10.00
    ELSE
      IF EMP-PERF-RATING EQ 4
        WS-RAISE-PCT = 7.50
      ELSE
        IF EMP-PERF-RATING EQ 3
          WS-RAISE-PCT = 5.00
        ELSE
          IF EMP-PERF-RATING EQ 2
            WS-RAISE-PCT = 2.50
          ELSE
            WS-RAISE-PCT = 0
          END-IF
        END-IF
      END-IF
    END-IF
*--- ADD LONGEVITY BONUS TO RAISE ---
    IF WS-YRS-SERVICE GT 20
      WS-RAISE-PCT = WS-RAISE-PCT + 2.00
    ELSE
      IF WS-YRS-SERVICE GT 10
        WS-RAISE-PCT = WS-RAISE-PCT + 1.00
      ELSE
        IF WS-YRS-SERVICE GT 5
          WS-RAISE-PCT = WS-RAISE-PCT + 0.50
        END-IF
      END-IF
    END-IF
*--- CALCULATE NEW SALARY ---
    WS-ANNUAL-SAL = EMP-BASE-PAY * 26
    WS-RAISE-AMT = WS-ANNUAL-SAL * WS-RAISE-PCT / 100
    WS-NEW-SALARY = WS-ANNUAL-SAL + WS-RAISE-AMT
  END-PROC
*
*============================================================
* REPORT 1: PAYROLL DETAIL REPORT
*============================================================
REPORT PAY-DETAIL-RPT PRINTER RPTFILE +
       PAGESIZE 55 LINESIZE 132 TALLYSIZE 6
  SEQUENCE EMP-DEPT EMP-LAST-NAME
  CONTROL EMP-DEPT EMP-REGION FINAL
  TITLE 01 'EMPLOYEE PAYROLL DETAIL REPORT'
  TITLE 02 'PAY PERIOD PROCESSING - BIWEEKLY'
  TITLE 03 ' '
  LINE 01 EMP-DEPT EMP-LAST-NAME EMP-FIRST-NAME +
          EMP-GRADE TRN-REG-HOURS TRN-OVT-HOURS +
          WS-GROSS-PAY WS-TOTAL-TAX WS-TOTAL-DEDUCT WS-NET-PAY
*
BEFORE-BREAK. PROC
  WS-HOURLY-RATE = WS-HOURLY-RATE / TALLY
END-PROC
*
*============================================================
* REPORT 2: PAYROLL SUMMARY REPORT (TOTALS ONLY)
*============================================================
REPORT PAY-SUMMARY-RPT PRINTER RPTFILE SUMMARY +
       PAGESIZE 55 LINESIZE 100
  SEQUENCE EMP-DEPT EMP-REGION
  CONTROL EMP-DEPT EMP-REGION FINAL
  TITLE 01 'PAYROLL SUMMARY BY DEPARTMENT AND REGION'
  TITLE 02 ' '
  LINE 01 EMP-DEPT EMP-REGION +
          WS-GROSS-PAY WS-TOTAL-TAX WS-NET-PAY
*
*============================================================
* REPORT 3: HIGH PAY EXCEPTION REPORT
*============================================================
REPORT HIGH-PAY-RPT PRINTER RPTFILE +
       PAGESIZE 55 LINESIZE 120
  SEQUENCE EMP-DEPT WS-NET-PAY D
  CONTROL EMP-DEPT FINAL
  TITLE 01 'HIGH PAY EXCEPTION REPORT'
  TITLE 02 'EMPLOYEES WITH NET PAY EXCEEDING $5,000'
  LINE 01 EMP-DEPT EMP-ID EMP-LAST-NAME EMP-FIRST-NAME +
          EMP-GRADE WS-GROSS-PAY WS-TOTAL-DEDUCT WS-NET-PAY +
          WS-YRS-SERVICE WS-RAISE-PCT

